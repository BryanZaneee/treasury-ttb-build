READER_PROVIDER=openai
READER_MODEL=gpt-5.6-luna
READER_BASE_URL=
READER_API_KEY=
# Takes precedence over READER_API_KEY for the openai provider.
OPENAI_API_KEY=
READER_EFFORT=none
READER_TIMEOUT_S=25
READER_CONCURRENCY=10
DAILY_VISION_CALL_CAP=300
ACCESS_TOKEN=
ADMIN_TOKEN=
AUTO_APPROVE_MATCHES=false
QA_SAMPLE_RATE=0.05
DATA_DIR=../data
# Read by Vite and deploy/deploy.sh, not by the API.
PUBLIC_BASE_PATH=

# Compiled into the browser bundle, and therefore public. The reviewer token is
# shared by design (there are no accounts, PRD §8); never give READER_API_KEY a
# VITE_ prefix. Leave VITE_ADMIN_TOKEN EMPTY in production - deploy.sh builds on
# the app host against its .env, so a value here would ship to every visitor,
# and it authorises replacing and resetting the store. Empty means the app asks
# a reviewer for the token and keeps it for that browser tab only.
VITE_ACCESS_TOKEN=
VITE_ADMIN_TOKEN=

# Read by deploy/backup.sh on the app host only. The script refuses to run
# without both rather than writing an unencrypted copy.
BACKUP_DEST=
BACKUP_RECIPIENT=
