# Label Verification Service API. Not containerised: the host already runs Caddy
# and others directly under systemd, so a runtime would add surface, not isolation.
#
# Install:  cp deploy/ttb-build.service /etc/systemd/system/
#           systemctl daemon-reload && systemctl enable --now ttb-build

[Unit]
Description=TTB Label Verification API (FastAPI)
After=network.target

[Service]
WorkingDirectory=/var/www/ttb-build/api
EnvironmentFile=/var/www/ttb-build/.env
ExecStart=/var/www/ttb-build/api/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8020
Restart=on-failure
RestartSec=3

# Reads its own tree, writes only the data directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/ttb-build/data

[Install]
WantedBy=multi-user.target
