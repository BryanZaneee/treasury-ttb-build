# Label Verification Service API.
#
# Deliberately not containerised: the target is a shared host that already runs
# Caddy and several other services directly under systemd, so an extra runtime
# would add operational surface without buying isolation we need.
#
# Install:  cp deploy/ttb-build.service /etc/systemd/system/
#           systemctl daemon-reload && systemctl enable --now ttb-build

[Unit]
Description=TTB Label Verification API (FastAPI)
After=network.target

[Service]
WorkingDirectory=/var/www/ttb-build/api
EnvironmentFile=/var/www/ttb-build/.env
ExecStart=/var/www/ttb-build/api/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8020
Restart=on-failure
RestartSec=3

# The service reads its own tree and writes only the data directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/ttb-build/data

[Install]
WantedBy=multi-user.target
