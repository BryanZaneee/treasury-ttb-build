# Add inside the existing `bryanzane.com, www.bryanzane.com { ... }` block,
# alongside the /llmbench and /com-voices subpath apps it already serves.
#
# handle_path strips the /ttb-build prefix, so the SPA sees paths at its own
# root and the API sees /api/* exactly as it does locally.
#
# The two inner handle blocks are mutually exclusive and evaluated in order,
# which matters: a bare `try_files` beside the proxy would rewrite /api/health
# to /index.html before the proxy matcher ever ran, and every API call would be
# answered with the SPA shell.

redir /ttb-build /ttb-build/ permanent

handle_path /ttb-build/* {
	handle /api/* {
		reverse_proxy 127.0.0.1:8020 {
			# Verification streams field results as they resolve; buffering
			# would hold the whole response and defeat the point.
			flush_interval -1
		}
	}

	handle {
		root * /var/www/ttb-build/web/dist

		# Vite fingerprints every asset, so those are safe to cache forever.
		# The SPA shell must never be cached: it is the file that names the
		# current bundle, and a cached copy pins visitors to a stale deploy —
		# which is exactly what happened on the first cutover.
		@fingerprinted path /assets/*
		header @fingerprinted Cache-Control "public, max-age=31536000, immutable"
		header Cache-Control "no-cache, must-revalidate"

		try_files {path} /index.html
		file_server
	}
}
