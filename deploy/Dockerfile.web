# M0: builds the route skeleton and serves it behind Caddy. PUBLIC_BASE_PATH
# is threaded in at build time (PRD §9).
FROM node:22-alpine AS build

ARG PUBLIC_BASE_PATH=
ENV PUBLIC_BASE_PATH=${PUBLIC_BASE_PATH}

WORKDIR /app
COPY web/package.json web/package-lock.json ./
RUN npm ci --legacy-peer-deps

COPY web/ ./
RUN npm run build

FROM caddy:2-alpine

COPY --from=build /app/dist /srv/labelverify/web
COPY deploy/Caddyfile /etc/caddy/Caddyfile

EXPOSE 8080
